VITE_API_BASE_URL=http://localhost:8080

# GET /api/dashboard/kpis já existe (T38) e cobre animais/vacinação/
# ocorrências/alertas — só o bloco "adocoes" continua mockado sempre (sem
# fonte no backend, ver docs/contratos/dashboard-kpis.md). Mude para true só
# se precisar trabalhar no frontend sem o backend rodando. Ausente = dados reais.
VITE_USE_MOCK_KPIS=false

# Idem para os gráficos do dashboard (casos por doença, raiva por espécie,
# resultados laboratoriais) — GET /api/dashboard/graficos já existe (T38).
# Ocupação por baia NÃO usa esta flag — já é dado real (GET /baias). Ver
# docs/contratos/dashboard-graficos.md.
VITE_USE_MOCK_GRAFICOS=false
