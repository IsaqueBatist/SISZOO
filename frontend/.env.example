VITE_API_BASE_URL=http://localhost:8080

# O endpoint abaixo ainda não existe no backend (pacote com.siszoo.relatorios
# é um esqueleto vazio) — mock default true até o backend implementar. Ver
# docs/contratos/dashboard-kpis.md.
VITE_USE_MOCK_KPIS=true

# Idem para os gráficos do dashboard (casos por doença, raiva por espécie,
# resultados laboratoriais). Ocupação por baia NÃO usa esta flag — já é dado
# real (GET /baias). Ver docs/contratos/dashboard-graficos.md.
VITE_USE_MOCK_GRAFICOS=true
