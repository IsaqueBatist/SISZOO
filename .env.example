# PostgreSQL
POSTGRES_DB=siszoo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (Spring Boot - perfil docker)
DB_URL=jdbc:postgresql://db:5432/siszoo
DB_USER=postgres
DB_PASSWORD=postgres

# Backend - seed do Admin inicial (DataSeeder)
ADMIN_SEED_EMAIL=admin.sistema@itu.sp.gov.br
ADMIN_SEED_PASSWORD=uma-senha-de-admin-para-dev

# Backend - autenticacao JWT
JWT_SECRET=uma-chave-bem-longa-para-dev-com-mais-de-32-bytes-1234567890

# Frontend (build-time, Vite)
VITE_API_BASE_URL=http://localhost:8080
