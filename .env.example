# PostgreSQL
POSTGRES_DB=siszoo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (Spring Boot - perfil docker)
DB_URL=jdbc:postgresql://db:5432/siszoo
DB_USER=postgres
DB_PASSWORD=postgres

# Backend - seed do Admin inicial (DataSeeder)
# A senha do seed nao passa pela politica de senha (so a API a aplica), mas
# use uma que a cumpra: ao menos 3 tipos de caractere (maiusculas, minusculas,
# numeros, simbolos) e sem "admin.sistema" nem "Administrador"/"SISZOO".
ADMIN_SEED_EMAIL=admin.sistema@itu.sp.gov.br
ADMIN_SEED_PASSWORD=Ccz-Dev-Itu-2026

# Backend - autenticacao JWT
# Obrigatoria, com 32 bytes ou mais: o backend nao sobe sem ela (JwtService).
# O valor abaixo e curto de proposito; gere uma chave propria com:
#   openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-gerada

# Backend - CORS: unica origem do frontend aceita pela API
SISZOO_CORS_ORIGIN=http://localhost:5173

# Backend - SMTP do EmailService (T35; docs/email.md)
# Desenvolvimento: use um SMTP sandbox (Mailtrap/Ethereal), que captura as
# mensagens sem entregar. Nunca credenciais reais neste arquivo.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=troque-pelo-usuario-do-sandbox
SMTP_PASSWORD=troque-pela-senha-do-sandbox
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# SMTPS (TLS implicito, porta 465): SMTP_SSL=true e SMTP_PORT=465; com ele,
# as SMTP_STARTTLS* nao se aplicam.
SMTP_SSL=false
SISZOO_MAIL_FROM=nao-responda@siszoo.test

# Frontend (build-time, Vite)
VITE_API_BASE_URL=http://localhost:8080

# Dados ficticios (perfil `seed` do backend, README "Dados fictícios"): use o
# override `docker compose -f docker-compose.yml -f docker-compose.seed.yml up`
# ou o backend local em `dev,seed`; nunca com `docker`/`prod` (a subida falha).
# SISZOO_SEED_HABILITADO=true
