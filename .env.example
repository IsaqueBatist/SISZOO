# PostgreSQL
POSTGRES_DB=siszoo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend (Spring Boot - perfil docker)
DB_URL=jdbc:postgresql://db:5432/siszoo
DB_USER=postgres
DB_PASSWORD=postgres

# Backend - seed do Admin inicial (DataSeeder)
ADMIN_SEED_EMAIL=admin.sistema@itu.sp.gov.br
ADMIN_SEED_PASSWORD=uma-senha-de-admin-para-dev

# Backend - autenticacao JWT
JWT_SECRET=uma-chave-bem-longa-para-dev-com-mais-de-32-bytes-1234567890

# Backend - SMTP do EmailService (T35; docs/email.md)
# Desenvolvimento: use um SMTP sandbox (Mailtrap/Ethereal), que captura as
# mensagens sem entregar. Nunca credenciais reais neste arquivo.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=troque-pelo-usuario-do-sandbox
SMTP_PASSWORD=troque-pela-senha-do-sandbox
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
# SMTPS (TLS implicito, porta 465): SMTP_SSL=true e SMTP_PORT=465; com ele,
# as SMTP_STARTTLS* nao se aplicam.
SMTP_SSL=false
SISZOO_MAIL_FROM=nao-responda@siszoo.test

# Frontend (build-time, Vite)
VITE_API_BASE_URL=http://localhost:8080

# Seed de dados de teste (npm run db:seed): API usada para criar as vacinações
SEED_API_URL=http://localhost:8080
