// ══════════════════════════════════════════════════════
// MÓDULO 01 — USUÁRIOS & ACESSO
// Tabelas: Usuario, Cargo, UsuarioCargo,
//          CargoPermissao, PreferenciaUsuario,
//          AuditoriaEvento
// Enums:   Modulo, TemaUsuario, DensidadeUsuario,
//          AcaoAuditoria
// ══════════════════════════════════════════════════════

// ── Enums ──────────────────────────────────────────────

Enum Modulo {
  USUARIOS_ACESSO
  GESTAO_ANIMAIS
  OCORRENCIAS_DENUNCIAS
  PROCESSOS_SANITARIOS
  RELATORIOS
}

Enum TemaUsuario {
  LIGHT
  DARK
}

Enum DensidadeUsuario {
  COMPACTO
  NORMAL
  CONFORTAVEL
}

Enum AcaoAuditoria {
  CRIACAO
  ATUALIZACAO
  DESATIVACAO
  REATIVACAO
  LOGIN
  LOGOUT
  EXPORTACAO
  ENCERRAMENTO
  VISUALIZACAO  // T26 (V12): acesso autorizado ao denunciante de ocorrência sigilosa
  ACESSO_NEGADO // T43 (V27): acesso ao denunciante sigiloso recusado pela regra de sigilo
}

// ── Usuario ────────────────────────────────────────────

Table Usuario {
  id                 uuid         [pk, not null, default: `gen_random_uuid()`]
  email              varchar(255) [not null, unique]
  senha              varchar(255) [not null]
  nome               varchar(100) [not null]
  sobrenome          varchar(100) [not null]
  crmv               varchar(20)
  telefone           varchar(20)
  ativo              boolean      [not null, default: true]
  dois_fatores_ativo boolean      [not null, default: false, note: 'reservado: nenhum uso na aplicação (docs/pendencias-documentacao.md)']
  ultimo_acesso      timestamp
  criado_em          timestamp    [not null, default: `now()`]
  senha_alterada_em  timestamp    [note: 'NULL = troca de senha obrigatória no primeiro acesso (POST /api/auth/senha); política de senha = regra 27 do DER']
  desativado_em      timestamp
  data_modificacao   timestamp    [not null, default: `now()`]

  indexes {
    email [unique]
  }
}

// ── Cargo e Permissões ─────────────────────────────────

Table Cargo {
  id        uuid         [pk, not null, default: `gen_random_uuid()`]
  nome      varchar(100) [not null]
  descricao text
}

Table UsuarioCargo {
  usuario_id    uuid      [not null, ref: > Usuario.id]
  cargo_id      uuid      [not null, ref: > Cargo.id]
  adicionado_em timestamp [not null, default: `now()`]

  indexes {
    (usuario_id, cargo_id) [pk]
  }

  Note: 'N:N no schema, mas a aplicação atribui exatamente um cargo por usuário (RF-C02; docs/decisoes/alinhamento-tg.md AT-4).'
}

Table CargoPermissao {
  id       uuid    [pk, not null, default: `gen_random_uuid()`]
  cargo_id uuid    [not null, ref: > Cargo.id]
  modulo   Modulo  [not null]
  feature  varchar(100) [not null, note: 'geral (módulo inteiro) ou denunciante_sigiloso (OCORRENCIAS_DENUNCIAS, só leitura: Administrador e Agente Sanitário, V10)']
  leitura  boolean [not null, default: false]
  escrita  boolean [not null, default: false]
  exclusao boolean [not null, default: false]

  indexes {
    (cargo_id, modulo, feature) [unique]
  }

  Note: 'Matriz fixa (V3/V10/V11): Admin RWD em tudo (R em relatórios); Veterinário RW animais e processos, R relatórios, sem ocorrências; Agente R animais, RW ocorrências e processos, R relatórios. Resolvida do banco a cada requisição.'
}

// ── Preferências ───────────────────────────────────────

Table PreferenciaUsuario {
  id                     uuid             [pk, not null, default: `gen_random_uuid()`]
  usuario_id             uuid             [not null, unique, ref: - Usuario.id]
  tema                   TemaUsuario      [not null, default: 'LIGHT']
  densidade              DensidadeUsuario [not null, default: 'NORMAL']
  notif_alertas_criticos boolean          [not null, default: true]
  notif_vacina_vencendo  boolean          [not null, default: true]
  notif_superlotacao     boolean          [not null, default: true]
  notif_resultado_lab    boolean          [not null, default: true]
  notif_email_diario     boolean          [not null, default: false]
}

// ── Auditoria ──────────────────────────────────────────

Table AuditoriaEvento {
  id             uuid          [pk, not null, default: `gen_random_uuid()`]
  usuario_id     uuid          [ref: > Usuario.id]
  acao           AcaoAuditoria [not null]
  entidade       varchar(100)  [not null]
  entidade_id    uuid          [note: 'V9: id do registro de entidade, polimórfico, sem FK']
  payload_antes  jsonb
  payload_depois jsonb
  ip             varchar(45)   [note: 'T43: endereço do socket da requisição; nulo fora de requisição HTTP']
  ocorreu_em     timestamp     [not null, default: `now()`]

  indexes {
    usuario_id
    entidade
    ocorreu_em
  }

  Note: 'Imutável no banco (V27, T43): UPDATE, DELETE e TRUNCATE recusados; só o ON DELETE SET NULL de usuario_id passa. Fonte: DER §3.8.'
}

TableGroup Usuarios_Acesso {
  Usuario
  Cargo
  UsuarioCargo
  CargoPermissao
  PreferenciaUsuario
  AuditoriaEvento
}