// ══════════════════════════════════════════════════════
// MÓDULO 02 — GESTÃO DE ANIMAIS DO CANIL E HISTÓRICO CLÍNICO
// Espelha as migrations V4, V5, V6, V7, V16, V18, V23–V26, V28
// (revisão de 25/10/2026, docs/decisoes/alinhamento-tg.md).
// Tabelas implementadas: Especie, StatusAnimal, MotivoEntrada,
//   TipoBaia, Baia, Animal, Vacina, Vacinacao, TipoProcedimento,
//   Procedimento, CategoriaFarmacologica, Medicamento, Prescricao,
//   TipoExame, Exame, AnexoAnimal, AnexoAnimalConteudo
// Modelo-alvo (SEM tabela — trabalho futuro): Adocao, AnexoVacinacao,
//   AnexoProcedimento, AnexoExame, VacinaEspecie, AnimalSintoma
// Enums (CHECK em varchar): Sexo, Porte, Pelagem, UnidadeDose,
//   UnidadeFrequencia, ViaAdministracao, StatusPrescricao
// Compartilhadas: Laboratorio (módulo 04), Usuario (módulo 01)
// Catálogos de espécie, status e motivo são TABELAS (codigo/nome),
// não enums — a API recebe e devolve o codigo.
// ══════════════════════════════════════════════════════

// ── Enums (valores do CHECK) ───────────────────────────

Enum Sexo {
  macho
  femea
  nao_identificado
}

Enum Porte {
  pequeno
  medio
  grande
}

Enum Pelagem {
  curta
  longa
}

Enum UnidadeDose {
  MILIGRAMA
  MICROGRAMA
  GRAMA
  MILILITRO
  UNIDADE_INTERNACIONAL
}

Enum UnidadeFrequencia {
  HORAS
  DIAS
}

Enum ViaAdministracao {
  ORAL
  INTRAVENOSA
  INTRAMUSCULAR
  SUBCUTANEA
  TOPICA
}

Enum StatusPrescricao {
  ATIVA
  CONCLUIDA
  SUSPENSA
  CANCELADA
}

// ── Catálogos (tabelas) ────────────────────────────────

Table Especie {
  id     uuid        [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30) [not null, unique, note: 'canino, felino, quiroptero, pnh']
  nome   varchar(60) [not null]
}

Table StatusAnimal {
  id     uuid        [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30) [not null, unique, note: 'disponivel_adocao, em_tratamento, em_quarentena, adotado, obito_natural, obito_eutanasia, transferido']
  nome   varchar(60) [not null]
}

Table MotivoEntrada {
  id     uuid        [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30) [not null, unique, note: 'recolhimento, abandono, entrega_voluntaria, resgate, apreensao_judicial']
  nome   varchar(60) [not null]
}

Table TipoBaia {
  id     uuid        [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30) [not null, unique, note: 'interna, gatil, externa']
  nome   varchar(60) [not null]
}

Table Vacina {
  id              uuid         [pk, not null, default: `gen_random_uuid()`]
  codigo          varchar(30)  [not null, unique]
  nome            varchar(100) [not null]
  intervalo_meses integer      [note: 'base da data de validade derivada (alerta de 7 dias)']
  ativo           boolean      [not null, default: true]
}

Table TipoProcedimento {
  id     uuid         [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30)  [not null, unique]
  nome   varchar(100) [not null]
  ativo  boolean      [not null, default: true]
}

Table CategoriaFarmacologica {
  id    uuid         [pk, not null, default: `gen_random_uuid()`]
  nome  varchar(100) [not null, unique]
  ativo boolean      [not null, default: true]
}

Table Medicamento {
  id           uuid         [pk, not null, default: `gen_random_uuid()`]
  nome         varchar(100) [not null]
  categoria_id uuid         [not null, ref: > CategoriaFarmacologica.id]
  ativo        boolean      [not null, default: true]
}

Table TipoExame {
  id     uuid         [pk, not null, default: `gen_random_uuid()`]
  codigo varchar(30)  [not null, unique, note: 'V25: hemograma, bioquimico, parasitologico, raspado_pele, citologia, sorologia, urinalise, radiografia, ultrassonografia']
  nome   varchar(100) [not null]
  ativo  boolean      [not null, default: true]
}

// ── Compartilhadas (definidas em outros módulos) ──────

Table Laboratorio {
  id uuid [pk, not null]
  Note: 'Módulo 04 (V13): codigo, nome, tipo, contato, ativo.'
}

Table Usuario {
  id uuid [pk, not null]
}

// ── Baia ───────────────────────────────────────────────

Table Baia {
  id           uuid        [pk, not null, default: `gen_random_uuid()`]
  nome         varchar(40) [not null]
  tipo_baia_id uuid        [not null, ref: > TipoBaia.id]
  capacidade   smallint    [not null]
  finalidade   varchar(80)
  ativa        boolean     [not null, default: true]
  observacoes  text

  Note: 'Ocupação não é coluna: contagem de animais sob custódia na baia. Criação/edição por Admin e Veterinário; desativação e exclusão lógica só Admin; tudo auditado (AT-5).'
}

// ── Animal ─────────────────────────────────────────────

Table Animal {
  id                    uuid         [pk, not null, default: `gen_random_uuid()`]
  nome                  varchar(80)  [not null]
  especie_id            uuid         [not null, ref: > Especie.id]
  sexo                  Sexo         [not null]
  raca                  varchar(80)
  coloracao             varchar(80)
  pelagem               Pelagem
  porte                 Porte
  peso_kg               decimal(5,2)
  idade_aprox           varchar(30)
  data_nascimento_aprox date
  microchip             varchar(30)  [unique, note: 'único quando informado (índice parcial, V16); normalizado sem espaços; imutável depois de definido']
  numero_medalha        varchar(30)  [unique, note: 'V23: único quando informado (índice parcial); normalizado sem espaços']
  data_implantacao_chip date         [note: 'V23: CHECK exige microchip; não futura']
  procedencia           varchar(200) [note: 'V23: origem na entrada, texto livre']
  esterilizado          boolean      [not null, default: false]
  data_esterilizacao    date
  status_id             uuid         [not null, ref: > StatusAnimal.id]
  motivo_entrada_id     uuid         [not null, ref: > MotivoEntrada.id]
  data_entrada          timestamp    [not null]
  baia_id               uuid         [ref: > Baia.id, note: 'NULL = em trânsito; baia ativa e com vaga ao alocar']
  ficha_completa        boolean      [not null, default: false, note: 'calculado: obrigatórios + microchip + ao menos 1 vacinação (V18)']
  laudo_eutanasia       text         [note: 'V24: obrigatório só na transição para obito_eutanasia (validado no serviço, sem CHECK)']
  foto_url              text
  foto_miniatura        text         [note: 'V28 (T45): miniatura para listagens']
  observacoes           text
  criado_por_id         uuid         [not null, ref: > Usuario.id]
  criado_em             timestamp    [not null, default: `now()`]
  atualizado_em         timestamp    [not null, default: `now()`]

  indexes {
    microchip      [unique]
    numero_medalha [unique]
    status_id
    especie_id
    baia_id
  }

  Note: 'Sem data_saida: a saída é a mudança de status (limitação registrada no TG). Cadastro/edição auditados (AT-5).'
}

// ── Vacinação (registro clínico imutável) ─────────────

Table Vacinacao {
  id              uuid         [pk, not null, default: `gen_random_uuid()`]
  animal_id       uuid         [not null, ref: > Animal.id]
  vacina_id       uuid         [not null, ref: > Vacina.id]
  aplicado_por_id uuid         [ref: > Usuario.id]
  data_aplicacao  date         [not null, note: 'não futura; validade = aplicação + intervalo da vacina (derivada)']
  numero_dose     integer
  dose_quantidade decimal(8,3) [not null]
  dose_unidade    UnidadeDose  [not null]
  lote            varchar(100)
  observacoes     text
  retifica_id     uuid         [unique, ref: - Vacinacao.id, note: 'correção: nova linha que aponta para a vigente (RN06)']
  criado_em       timestamp    [not null, default: `now()`]

  Note: 'Sem UPDATE/DELETE (triggers V17).'
}

// ── Procedimento (registro clínico imutável) ──────────

Table Procedimento {
  id                   uuid      [pk, not null, default: `gen_random_uuid()`]
  animal_id            uuid      [not null, ref: > Animal.id]
  tipo_procedimento_id uuid      [not null, ref: > TipoProcedimento.id]
  executado_por_id     uuid      [ref: > Usuario.id]
  data                 date      [not null]
  descricao            text
  resultado            text
  retifica_id          uuid      [unique, ref: - Procedimento.id]
  criado_em            timestamp [not null, default: `now()`]

  Note: 'Sem UPDATE/DELETE (triggers V17).'
}

// ── Prescrição (registro clínico imutável) ────────────

Table Prescricao {
  id                  uuid              [pk, not null, default: `gen_random_uuid()`]
  animal_id           uuid              [not null, ref: > Animal.id]
  prescrito_por_id    uuid              [ref: > Usuario.id]
  medicamento_id      uuid              [not null, ref: > Medicamento.id]
  data_inicio         date              [not null]
  data_fim_prevista   date
  data_fim_real       date
  frequencia_aplicada integer           [not null]
  unidade_frequencia  UnidadeFrequencia [not null]
  dose_quantidade     decimal(8,3)      [not null]
  dose_unidade        UnidadeDose       [not null]
  via_administracao   ViaAdministracao  [not null]
  status              StatusPrescricao  [not null]
  retifica_id         uuid              [unique, ref: - Prescricao.id]
  criado_em           timestamp         [not null, default: `now()`]

  Note: 'Sem UPDATE/DELETE (triggers V17).'
}

// ── Exame (V25, registro clínico imutável) ────────────

Table Exame {
  id                uuid      [pk, not null, default: `gen_random_uuid()`]
  animal_id         uuid      [not null, ref: > Animal.id]
  tipo_exame_id     uuid      [not null, ref: > TipoExame.id]
  laboratorio_id    uuid      [ref: > Laboratorio.id]
  solicitado_por_id uuid      [ref: > Usuario.id]
  data_solicitacao  date      [not null, note: 'não futura']
  data_resultado    date      [note: 'CHECK >= data_solicitacao; vem junto com resultado']
  resultado         text
  observacoes       text
  retifica_id       uuid      [unique, ref: - Exame.id]
  criado_em         timestamp [not null, default: `now()`]

  Note: 'Sem UPDATE/DELETE (triggers V17). API: GET/POST /api/exames (AT-8).'
}

// ── Anexos do animal (V26) ────────────────────────────

Table AnexoAnimal {
  id            uuid         [pk, not null, default: `gen_random_uuid()`]
  animal_id     uuid         [not null, ref: > Animal.id]
  nome          varchar(255) [not null]
  mime_type     varchar(50)  [not null, note: 'CHECK: image/jpeg, image/png, application/pdf (detectado pelos bytes)']
  tamanho       integer      [not null, note: 'CHECK <= 5242880 (5 MB)']
  descricao     varchar(200)
  criado_por_id uuid         [not null, ref: > Usuario.id]
  criado_em     timestamp    [not null, default: `now()`]

  Note: 'Máximo 10 por animal; upload e download auditados. Conteúdo em AnexoAnimalConteudo (padrão D9).'
}

Table AnexoAnimalConteudo {
  anexo_id uuid  [pk, not null, ref: - AnexoAnimal.id]
  conteudo bytea [not null]
}

// ── Modelo-alvo (SEM tabela; trabalho futuro — AT-7/AT-8/AT-13) ──

Table Adocao {
  id                uuid         [pk]
  animal_id         uuid         [ref: - Animal.id]
  registrado_por    uuid         [ref: > Usuario.id]
  adotante_nome     varchar(150)
  adotante_cpf      varchar(14)
  adotante_telefone varchar(20)
  adotante_email    varchar(150)
  adotante_cep      varchar(10)
  adotante_endereco varchar(255)
  adotante_bairro   varchar(80)
  data_adocao       date
  data_devolucao    date
  motivo_devolucao  text
  observacoes       text
  criado_em         timestamp

  Note: 'MODELO-ALVO — não implementada. Hoje a adoção é só o status adotado do animal.'
}

Table AnexoVacinacao {
  id           uuid [pk]
  vacinacao_id uuid [ref: > Vacinacao.id]
  Note: 'MODELO-ALVO — não implementada; anexos ficam em AnexoAnimal.'
}

Table AnexoProcedimento {
  id              uuid [pk]
  procedimento_id uuid [ref: > Procedimento.id]
  Note: 'MODELO-ALVO — não implementada; anexos ficam em AnexoAnimal.'
}

Table AnexoExame {
  id       uuid [pk]
  exame_id uuid [ref: > Exame.id]
  Note: 'MODELO-ALVO — não implementada; anexos ficam em AnexoAnimal.'
}

Table VacinaEspecie {
  vacina_id  uuid [pk, ref: > Vacina.id]
  especie_id uuid [pk, ref: > Especie.id]
  Note: 'MODELO-ALVO — não implementada (vacina não é restrita por espécie).'
}

Table AnimalSintoma {
  animal_id  uuid [pk, ref: > Animal.id]
  sintoma_id uuid [pk]
  Note: 'MODELO-ALVO — não implementada (sintomas só na amostra do processo, módulo 04).'
}

TableGroup Canil {
  Especie
  StatusAnimal
  MotivoEntrada
  TipoBaia
  Baia
  Animal
  Vacina
  Vacinacao
  TipoProcedimento
  Procedimento
  CategoriaFarmacologica
  Medicamento
  Prescricao
  TipoExame
  Exame
  AnexoAnimal
  AnexoAnimalConteudo
}

TableGroup Canil_modelo_alvo {
  Adocao
  AnexoVacinacao
  AnexoProcedimento
  AnexoExame
  VacinaEspecie
  AnimalSintoma
}
